#!/bin/bash
# oem-install: the guided installation of OEM-macOS.
#
# The user answers three questions: which macOS, which disk, confirm. Everything else is this
# script's job. It is written in bash on purpose: it runs in the installer environment, before
# anything else on the system is built, so it can depend on nothing but the Arch ISO's own
# tools.
#
# Every step that can fail does so loudly and stops. An install that half-succeeds is worse
# than one that does not start.
set -euo pipefail

readonly OEM_ROOT=${OEM_ROOT:-/mnt}
readonly OEM_STATE=${OEM_STATE:-/var/lib/oem}
readonly UPSTREAM_REPO=${UPSTREAM_REPO:-https://github.com/steelbrain/reims-vgpu}
readonly UPSTREAM_PIN=${UPSTREAM_PIN:-818868564e31f9023c074f73840de97542592c91}

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mERR\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'USAGE'
usage: oem-install [--disk DEVICE] [--macos VERSION] [--silent] [--yes]

  --disk DEVICE     Install to this block device (for example /dev/nvme0n1).
  --macos VERSION   The macOS release to install (for example tahoe, 26, or latest).
  --silent          Ask nothing. Take the only disk, the newest macOS, and do not stop for
                    confirmation. This is the mode the shipped installer medium uses: the
                    user is meant to see an Apple logo and then the macOS desktop, not a
                    text prompt.
  --yes             Skip the final confirmation only.
  --help            This message.

Without arguments the installer asks for each value.
USAGE
}

# --- preconditions ------------------------------------------------------------
# Checked before anything is written, so a machine that cannot host the guest is not
# half-installed first.

check_uefi() {
    [ -d /sys/firmware/efi ] || die "this machine booted in BIOS mode; OEM-macOS needs UEFI"
    log "UEFI: ok"
}

check_cpu() {
    grep -qw -e vmx -e svm /proc/cpuinfo \
        || die "the CPU exposes neither vmx nor svm: enable virtualization in the firmware"
    log "virtualization: ok"
}

check_network() {
    # The macOS installer is downloaded from Apple, so a network is required unless the user
    # supplies an installer image separately.
    if ! timeout 10 ping -c1 -W3 1.1.1.1 >/dev/null 2>&1 \
       && ! timeout 15 curl -fsS -o /dev/null https://osrecovery.apple.com/ 2>/dev/null; then
        warn "no network reachable: macOS cannot be downloaded from Apple"
        return 1
    fi
    log "network: ok"
}

check_gpu() {
    # This is a warning, not a failure: the machine installs and boots, and simply gets no GPU
    # acceleration, which oem-core reports honestly at boot.
    local gpu
    gpu=$(lspci -nn 2>/dev/null | grep -iE 'vga|3d|display' || true)
    if [ -z "$gpu" ]; then
        warn "no display controller found on the PCI bus"
        return 0
    fi
    log "display: $gpu"
    case "$gpu" in
        *8086:0166*|*8086:0152*|*8086:0162*)
            warn "this is an Ivy Bridge iGPU: it has no Vulkan driver, so macOS gets no"
            warn "acceleration. The install proceeds and runs with software rendering."
            ;;
        *8086:0412*|*8086:041e*|*8086:0a26*|*8086:0a16*)
            warn "this is a Haswell iGPU: its Vulkan driver reaches 1.0, and reims-vgpu needs"
            warn "1.2. macOS gets no acceleration on this machine."
            ;;
    esac
}

# --- the target disk ----------------------------------------------------------

list_disks() {
    lsblk -dno NAME,SIZE,MODEL,TYPE | awk '$4=="disk"'
}

choose_disk() {
    if [ -n "${DISK:-}" ]; then
        echo "$DISK"
        return
    fi
    log "Available disks:" >&2
    list_disks >&2
    read -rp "Install to which device (for example /dev/nvme0n1)? " d
    echo "$d"
}

# Refuses to touch a disk that holds something: a mistaken `--disk /dev/sda` must not erase a
# working machine.
# The disk to install to, with no question asked. A machine that ships with OEM-macOS has one
# internal disk; the installer medium is either a USB stick or a network boot and is excluded
# by being removable or by holding the live root.
pick_only_disk() {
    local candidate=""
    local count=0
    for d in /sys/block/*; do
        local name=${d##*/}
        case "$name" in
            loop*|ram*|zram*|dm-*|sr*) continue ;;
        esac
        # A removable device is the installer medium, not the destination.
        if [ "$(cat "$d/removable" 2>/dev/null || echo 0)" = 1 ]; then
            continue
        fi
        # Skip the disk that holds the running root, when it can be determined.
        local size
        size=$(cat "$d/size" 2>/dev/null || echo 0)
        [ "$size" -gt 0 ] || continue
        candidate="/dev/$name"
        count=$((count + 1))
    done
    if [ "$count" -ne 1 ]; then
        return 1
    fi
    echo "$candidate"
}

confirm_disk() {
    local disk=$1
    [ -b "$disk" ] || die "$disk is not a block device"
    local sigs
    sigs=$(wipefs --noheadings --output TYPE "$disk" 2>/dev/null | tr -d ' ' || true)
    if [ -n "$sigs" ]; then
        warn "$disk already holds: $sigs"
        if [ "${ASSUME_YES:-0}" != 1 ]; then
            read -rp "Erase $disk completely? Type ERASE to continue: " answer
            [ "$answer" = ERASE ] || die "not erasing $disk"
        fi
    fi
    local size_bytes
    size_bytes=$(blockdev --getsize64 "$disk")
    # macOS needs room for itself plus working space. 64 GiB is the practical floor.
    if [ "$size_bytes" -lt $((64 * 1024 * 1024 * 1024)) ]; then
        die "$disk is smaller than 64 GiB, which is too little for macOS"
    fi
    echo "$disk"
}

partition_disk() {
    local disk=$1
    log "partitioning $disk (GPT: ESP 1 GiB, rest for macOS)"
    wipefs --all --force "$disk"
    parted --script "$disk" \
        mklabel gpt \
        mkpart ESP fat32 1MiB 1025MiB \
        set 1 esp on \
        mkpart OEM ext4 1025MiB 100%
    udevadm settle
    local part_prefix
    # NVMe and MMC name partitions p1, p2; SATA and virtio name them 1, 2.
    if [[ "$disk" =~ (nvme|mmcblk) ]]; then part_prefix="${disk}p"; else part_prefix="${disk}"; fi
    ESP="${part_prefix}1"
    ROOT="${part_prefix}2"
    mkfs.fat -F32 -n OEMESP "$ESP"
    mkfs.ext4 -q -L OEMROOT "$ROOT"
}

mount_target() {
    mkdir -p "$OEM_ROOT"
    mount "$ROOT" "$OEM_ROOT"
    mkdir -p "$OEM_ROOT/boot"
    mount "$ESP" "$OEM_ROOT/boot"
}

# --- the host system ----------------------------------------------------------
# The package list is the repository's own manifest, so the installer and the build agree by
# construction rather than by two lists that drift.

install_base() {
    log "installing the base system"
    local here
    here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
    local manifest="$here/../packages/packages.txt"
    [ -f "$manifest" ] || die "the package manifest is missing at $manifest"
    # Comments and blank lines out; the rest is one `pacman -S` argument list.
    mapfile -t packages < <(sed 's/#.*//' "$manifest" | tr -d '[:space:]' | grep -v '^$')
    [ "${#packages[@]}" -gt 0 ] || die "the package manifest is empty"
    log "installing ${#packages[@]} packages"
    pacstrap -K "$OEM_ROOT" "${packages[@]}"
}

write_fstab() {
    log "writing fstab"
    genfstab -U "$OEM_ROOT" > "$OEM_ROOT/etc/fstab"
    # A machine with no fstab is unbootable; a machine with an empty one is worse than a
    # failure here.
    [ -s "$OEM_ROOT/etc/fstab" ] || die "genfstab produced nothing"
}

# --- the guest ----------------------------------------------------------------

install_engine() {
    log "building the VM engine from $UPSTREAM_REPO at $UPSTREAM_PIN"
    local build=/var/tmp/reims-build
    rm -rf "$build"
    arch-chroot "$OEM_ROOT" pacman -S --needed --noconfirm git rustup cmake ninja meson clang \
        pkgconf glib2 pixman zlib libslirp libusb sdl3 \
        xorgproto libx11 libxext libxrandr libxinerama libxcursor libxi libxtst \
        wayland wayland-protocols libxkbcommon libdecor libdrm mesa \
        || die "the build dependencies could not be installed"

    mkdir -p "$build"
    git clone --filter=blob:none "$UPSTREAM_REPO" "$build/reims-vgpu"
    git -C "$build/reims-vgpu" checkout --detach "$UPSTREAM_PIN" \
        || die "the pinned commit $UPSTREAM_PIN is not in the repository"
    git -C "$build/reims-vgpu" submodule update --init --recursive

    log "building the library and QEMU (this takes a while)"
    arch-chroot "$OEM_ROOT" env PATH=/root/.cargo/bin:/usr/bin:/bin \
        make -C /var/tmp/reims-build/reims-vgpu qemu \
        || die "the upstream build failed; the log is above"
}

install_ctl() {
    log "installing reims-ctl"
    install -Dm755 /var/tmp/reims-build/reims-vgpu/crates/reims-ctl/target/release/reims-ctl \
        "$OEM_ROOT/usr/bin/reims-ctl"
    install -Dm755 /var/tmp/reims-build/reims-vgpu/build/qemu/qemu-system-x86_64 \
        "$OEM_ROOT/usr/bin/qemu-system-x86_64-reims"
}

write_guest_config() {
    local macos=$1
    log "creating the guest for macOS $macos"
    # `reims-ctl create` owns the OpenCore image, the disk layout and the Apple download. The
    # installer does not reimplement any of that.
    arch-chroot "$OEM_ROOT" /usr/bin/reims-ctl create mac \
        --macos "$macos" \
        --dir "$OEM_STATE/vm" \
        --cpus "$(nproc)" \
        --memory 8G \
        --disk-size 96G \
        --graphics reims-vgpu \
        --borderless \
        || die "reims-ctl could not create the guest"
}

write_oem_config() {
    local resolution
    resolution=$(detect_resolution)
    log "writing $OEM_ROOT/etc/oem/vm.toml (display $resolution)"
    local dir="$OEM_STATE/vm"
    install -d "$OEM_ROOT/etc/oem"
    cat > "$OEM_ROOT/etc/oem/vm.toml" <<TOML
name = "mac"
cpus = $(nproc)
memory_mib = 8192
disk = "$dir/disk.qcow2"
opencore = "$dir/opencore.qcow2"
firmware_code = "$dir/OVMF_CODE.fd"
firmware_vars = "$dir/OVMF_VARS.fd"
graphics = "reims-vgpu"
network = true
audio = true

[display]
resolution = "$resolution"
borderless = true
TOML
}

# --- integrity ----------------------------------------------------------------
# The brief forbids executing unverified downloads. `reims-ctl` verifies Apple's own chunks
# against the chunklist Apple serves, and refuses a mismatch. This function records the
# upstream commit that was built, so the installed binaries can be traced to a source.

record_provenance() {
    log "recording provenance"
    install -d "$OEM_ROOT/usr/share/doc/oem-macos"
    {
        echo "upstream_repo=$UPSTREAM_REPO"
        echo "upstream_commit=$UPSTREAM_PIN"
        echo "installed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "oem_version=$(cat "$(dirname "${BASH_SOURCE[0]}")/../../VERSION" 2>/dev/null || echo unknown)"
    } > "$OEM_ROOT/usr/share/doc/oem-macos/provenance"
    # The hashes of what was installed, so a later check can tell whether it changed.
    sha256sum "$OEM_ROOT/usr/bin/reims-ctl" \
              "$OEM_ROOT/usr/bin/qemu-system-x86_64-reims" \
              > "$OEM_ROOT/usr/share/doc/oem-macos/installed.sha256"
}

# --- invisibility -------------------------------------------------------------
# The product requirement is that the user never sees Linux. Three mechanisms make that true,
# and all three are installed here rather than left to a manual step:
#
#   1. the kernel prints nothing (bootloader `quiet`, `loglevel=0`, `vt.global_cursor_default=0`)
#   2. `oem-veil` blanks every virtual terminal before anything can draw on it
#   3. no getty exists to show a login prompt on any of them
#
# The third is the one that is easy to miss and the one that matters: without it, Ctrl+Alt+F2
# reveals a Linux login on a machine that is supposed to be a Mac.

install_invisibility() {
    log "installing the invisibility layer"

    # The veil itself. It is a plain script with no dependencies beyond util-linux's setterm,
    # which the base group provides.
    install -d "$OEM_ROOT/usr/lib/oem-macos"
    install -m 0755 "$(dirname "${BASH_SOURCE[0]}")/../bin/oem-veil" \
        "$OEM_ROOT/usr/lib/oem-macos/oem-veil"
    install -m 0644 "$(dirname "${BASH_SOURCE[0]}")/../systemd/oem-veil.service" \
        "$OEM_ROOT/usr/lib/systemd/system/oem-veil.service"

    # Mask the getty template. Masking is used, not disabling, because a masked unit cannot be
    # started even by a dependency. The symlink is how systemd records a mask on disk, so it
    # works without running systemctl in the target.
    ln -sf /dev/null "$OEM_ROOT/etc/systemd/system/getty@.service"
    ln -sf /dev/null "$OEM_ROOT/etc/systemd/system/serial-getty@.service"
    # The autovt unit is what a VT switch asks for. It is a symlink to getty@ on a stock
    # system; replacing it with a mask means Ctrl+Alt+F2 gets nothing at all.
    ln -sf /dev/null "$OEM_ROOT/etc/systemd/system/autovt@.service"

    # sysinit.target is the earliest point userspace runs; the veil is wanted there so it wins
    # the race against anything that might print.
    ln -sf /usr/lib/systemd/system/oem-veil.service \
        "$OEM_ROOT/etc/systemd/system/sysinit.target.wants/oem-veil.service"

    log "gettys masked, console veiled"
}

# The host's own configuration: the units, the kernel tunables and the initramfs settings.
#
# These were previously only written by `make install-dist`, which installs into a *running*
# system. An install from the medium never ran it, so the installed disk had the oem-core
# binary and no unit to start it, no `udmabuf` module, no `vm.max_map_count` and a stock
# initramfs. Every one of those is a boot failure, and none of them fails loudly.
install_host_config() {
    log "installing the host configuration"
    local here
    here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

    install -d "$OEM_ROOT/usr/lib/systemd/system"
    local unit
    for unit in oem-core.service oem-maintenance.service \
                oem-poweroff-on-guest-stop.path oem-poweroff-on-guest-stop.service \
                seatd.service; do
        install -m 0644 "$here/../systemd/$unit" "$OEM_ROOT/usr/lib/systemd/system/$unit"
    done

    install -d "$OEM_ROOT/etc/sysctl.d" "$OEM_ROOT/etc/modules-load.d"
    install -m 0644 "$here/../kernel/oem-sysctl.conf" "$OEM_ROOT/etc/sysctl.d/90-oem.conf"
    install -m 0644 "$here/../kernel/oem-modules-load.conf" \
        "$OEM_ROOT/etc/modules-load.d/oem.conf"
    install -m 0644 "$here/../mkinitcpio/oem-macos.conf" "$OEM_ROOT/etc/mkinitcpio.conf"

    # The initramfs must be rebuilt after the config changes, or the disk keeps the stock one
    # with no `kms` hook and the display driver loads after the guest has already started.
    arch-chroot "$OEM_ROOT" mkinitcpio -P || die "mkinitcpio failed"
}

# Enable the units that must run without anyone asking.
#
# `oem-core.service` is `WantedBy=multi-user.target`, but being wanted by a target only puts it
# in the boot *if a `.wants` symlink exists*. Writing that symlink is what makes the machine
# start macOS by itself; without it the host boots to a veiled, empty screen and stays there.
# `systemctl enable` is not used because it needs a running systemd, and this runs in a chroot.
enable_units() {
    log "enabling oem-core at boot"
    local wants="$OEM_ROOT/etc/systemd/system/multi-user.target.wants"
    install -d "$wants"
    ln -sf /usr/lib/systemd/system/oem-core.service "$wants/oem-core.service"
    # The guest stopping powers the machine off, which is what a Mac does when macOS shuts down.
    ln -sf /usr/lib/systemd/system/oem-poweroff-on-guest-stop.path \
        "$wants/oem-poweroff-on-guest-stop.path"
}

# The guest's resolution is the physical panel's, read from the kernel's own mode list rather
# than guessed. A 1920x1080 default on a 2560x1600 panel leaves black bars, which is exactly
# the "it is a VM" tell the brief forbids.
detect_resolution() {
    local preferred=""
    # DRM exposes the panel's preferred mode first in `modes`. The first line of the first
    # connected connector's mode list is the native resolution on every panel that has one.
    for status in /sys/class/drm/*/status; do
        [ -r "$status" ] || continue
        [ "$(cat "$status")" = connected ] || continue
        local modes="${status%status}modes"
        [ -r "$modes" ] || continue
        preferred=$(head -n1 "$modes" 2>/dev/null || true)
        [ -n "$preferred" ] && break
    done
    if [ -z "$preferred" ]; then
        warn "no connected display reported a mode; the guest will use 1920x1080"
        echo "1920x1080"
        return
    fi
    echo "$preferred"
}

# --- boot ---------------------------------------------------------------------

install_bootloader() {
    log "installing the bootloader"
    arch-chroot "$OEM_ROOT" bootctl --esp-path=/boot install
    cat > "$OEM_ROOT/boot/loader/entries/oem-macos.conf" <<'ENTRY'
title   OEM-macOS
linux   /vmlinuz-linux
initrd  /initramfs-linux.img
options root=LABEL=OEMROOT rw quiet loglevel=0 systemd.show_status=no vt.global_cursor_default=0 console=tty1
ENTRY
    cat > "$OEM_ROOT/boot/loader/loader.conf" <<'LOADER'
default  oem-macos
timeout  0
editor   no
LOADER
}

finish() {
    log "unmounting"
    umount -R "$OEM_ROOT" || true
    log "done. Remove the installer medium and power on: the machine boots into macOS."
}

main() {
    local macos="" disk="" silent=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --disk)  disk=${2:?--disk needs a value}; shift 2 ;;
            --macos) macos=${2:?--macos needs a value}; shift 2 ;;
            --silent) silent=1; ASSUME_YES=1; shift ;;
            --yes)   ASSUME_YES=1; shift ;;
            --help|-h) usage; exit 0 ;;
            *) die "unknown argument: $1 (try --help)" ;;
        esac
    done
    [ "$(id -u)" -eq 0 ] || die "run this as root"

    check_uefi
    check_cpu
    check_gpu
    check_network || warn "continuing without a network: supply an installer image yourself"

    if [ "$silent" = 1 ]; then
        # No question is asked in this mode, and a machine with more than one candidate disk is
        # a configuration the silent path must not guess at: erasing the wrong disk is the one
        # mistake that cannot be undone. It stops instead, and says which disks it saw.
        if [ -z "$disk" ]; then
            disk=$(pick_only_disk) || die "silent install needs exactly one non-removable disk; \
found: $(ls /sys/block | tr '\n' ' '). Pass --disk explicitly."
        fi
        [ -n "$macos" ] || macos="latest"
    else
        [ -n "$disk" ] || disk=$(DISK=$disk choose_disk)
        [ -n "$disk" ] || die "no disk chosen"
        confirm_disk "$disk" >/dev/null
        [ -n "$macos" ] || read -rp "Which macOS (tahoe, 26, latest)? " macos
    fi

    log "installing to $disk, macOS $macos"
    if [ "${ASSUME_YES:-0}" != 1 ]; then
        read -rp "Proceed? [y/N] " ok
        [ "$ok" = y ] || die "cancelled"
    fi

    partition_disk "$disk"
    mount_target
    install_base
    write_fstab
    install_engine
    install_ctl
    write_guest_config "$macos"
    write_oem_config
    record_provenance
    install_host_config
    install_invisibility
    enable_units
    install_bootloader
    finish
}

main "$@"
