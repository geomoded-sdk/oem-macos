#!/bin/bash
# oem-installer-autostart: what runs instead of a login prompt on the installer medium.
#
# The brief's requirement is that the user sees an Apple logo and then the macOS desktop, never
# a Linux prompt. So this runs before anything can draw on tty1, and it does three things:
#
#   1. blanks the console and hides the cursor, so boot text is not what remains on screen
#   2. runs `oem-install --silent`, which asks nothing and needs exactly one disk
#   3. if that fails, opens a shell on the same tty, because a medium that hides its own
#      failure is worse than one that shows a prompt
#
# Step 3 is not a convenience. `--silent` refuses a machine with more than one candidate disk on
# purpose, and that refusal has to be readable or the user cannot learn why nothing happened.
set -uo pipefail

readonly INSTALLER=/usr/local/bin/oem-install

veil() {
    setterm --blank 0 --powerdown 0 --cursor off 2>/dev/null || true
    printf '\033[2J\033[H\033[?25l' > /dev/tty1 2>/dev/null || true
}

fail_shell() {
    local why=$1
    printf '\033[?25h' > /dev/tty1 2>/dev/null || true
    printf '\nOEM-macOS could not install itself.\n\n%s\n\n' "$why" > /dev/tty1
    printf 'A shell follows. The disk was not modified if the failure was before partitioning.\n' \
        > /dev/tty1
    exec /bin/bash --login
}

main() {
    veil

    [ -x "$INSTALLER" ] || fail_shell "the installer is missing at $INSTALLER; this medium is broken"

    # The medium is UEFI-only by design; say so here rather than letting check_uefi's message be
    # the only one the user sees on a black screen.
    [ -d /sys/firmware/efi ] || fail_shell "this machine booted in BIOS mode; OEM-macOS needs UEFI"

    local out
    if out=$("$INSTALLER" --silent 2>&1); then
        printf '\033[2J\033[H' > /dev/tty1
        printf 'Installation complete. Remove the medium and power on.\n' > /dev/tty1
        # A finished install must not sit on a Linux prompt: a visible shell here is exactly
        # the "it is a Linux box" tell the brief forbids.
        sleep 30
        poweroff -f
    else
        fail_shell "$out"
    fi
}

main "$@"
